library(tidyverse)
library(knitr)
dados_limpos <- read_csv(
file.choose(),
na = c("", "NA", "?")
)
kable(
dados_limpos %>%
count(sexo) %>%
mutate(Percentual = round(n / sum(n) * 100, 1))
)
kable(
dados_limpos %>%
count(Diagnostico) %>%
mutate(Percentual = round(n / sum(n) * 100, 1))
)
kable(
dados_limpos %>%
count(Diagnostico) %>%
mutate(Percentual = round(n / sum(n) * 100, 1))
)
kable(
dados_limpos %>%
count(class.idade) %>%
mutate(Percentual = round(n / sum(n) * 100, 1))
)
kable(
dados_limpos %>%
count(sintoma_inicial) %>%
mutate(Percentual = round(n / sum(n) * 100, 1))
)
